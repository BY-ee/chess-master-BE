generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  username      String         @unique
  password      String
  createdAt     DateTime       @default(now()) @map("created_at")

  gamesAsBlack  Game[]         @relation("BlackPlayer")
  gamesAsWhite  Game[]         @relation("WhitePlayer")
  refreshTokens RefreshToken[]
  aiStats       UserAiStats[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AiModel {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  rating    Int      @default(1000)
  type      String   @default("stockfish")
  config    Json
  createdAt DateTime @default(now()) @map("created_at")

  gamesAsBlack Game[]        @relation("BlackAi")
  gamesAsWhite Game[]        @relation("WhiteAi")
  stats        UserAiStats[]

  @@map("ai_models")
}

model UserAiStats {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  aiModelId Int      @map("ai_model_id")
  
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  
  user      User     @relation(fields: [userId], references: [id])
  aiModel   AiModel  @relation(fields: [aiModelId], references: [id])
  
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, aiModelId])
  @@map("user_ai_stats")
}

model Game {
  id        Int      @id @default(autoincrement())
  
  whiteId   Int?     @map("white_id")
  blackId   Int?     @map("black_id")
  whiteAiId Int?     @map("white_ai_id")
  blackAiId Int?     @map("black_ai_id")

  pgn       String   @default("")
  result    String?
  createdAt DateTime @default(now()) @map("created_at")
  
  blackAi   AiModel? @relation("BlackAi", fields: [blackAiId], references: [id])
  black     User?    @relation("BlackPlayer", fields: [blackId], references: [id])
  whiteAi   AiModel? @relation("WhiteAi", fields: [whiteAiId], references: [id])
  white     User?    @relation("WhitePlayer", fields: [whiteId], references: [id])

  @@map("games")
}
